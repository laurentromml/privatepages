# Ignore everything in home directory by default
*
.*

# Track only the website project
!auroraflow-website/
!auroraflow-website/**
!README.md
!.gitignore

# Root index of private pages
!robots.txt
!pivotree/
!pivotree/**

# Daily prep briefings
!daily-prep/
!daily-prep/**

# Disable Jekyll so the bare root URL 404s (no README fallback)
!.nojekyll
